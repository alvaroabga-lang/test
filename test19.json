{
  "titulo": "Test 4. Tema 4. Atención al Ciudadano",
  "preguntas": [
    {
      "pregunta": "El artículo 13 reconoce el derecho:",
      "opciones": {
        "A": "A recibir asistencia en el uso de medios electrónicos.",
        "B": "A no identificarse nunca.",
        "C": "A acceder a cualquier dato privado.",
        "D": "A modificar procedimientos."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "El artículo 13 reconoce el derecho a utilizar:",
      "opciones": {
        "A": "Las lenguas oficiales en los términos legales.",
        "B": "Cualquier idioma sin limitación.",
        "C": "Solo el inglés.",
        "D": "Ninguna lengua cooficial."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "El artículo 13 reconoce el acceso a:",
      "opciones": {
        "A": "Información pública, archivos y registros.",
        "B": "Cualquier expediente privado.",
        "C": "Datos personales de terceros.",
        "D": "Información secreta."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "El artículo 13 reconoce el derecho a:",
      "opciones": {
        "A": "Ser tratados con respeto y deferencia.",
        "B": "Exigir cualquier resultado.",
        "C": "Dictar resoluciones.",
        "D": "Eliminar sanciones."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "El artículo 13 reconoce el derecho a:",
      "opciones": {
        "A": "Exigir responsabilidades cuando legalmente corresponda.",
        "B": "Imponer sanciones.",
        "C": "Resolver expedientes.",
        "D": "Sustituir al funcionario."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "El artículo 13 reconoce el derecho a:",
      "opciones": {
        "A": "Obtener y utilizar medios de identificación y firma electrónica.",
        "B": "No identificarse.",
        "C": "Utilizar cualquier firma sin requisitos.",
        "D": "Eliminar la identificación."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "La protección de datos incluye:",
      "opciones": {
        "A": "Seguridad y confidencialidad.",
        "B": "Publicidad absoluta.",
        "C": "Acceso universal.",
        "D": "Eliminación automática."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "Los derechos del artículo 13 se entienden:",
      "opciones": {
        "A": "Sin perjuicio de los derechos del artículo 53.",
        "B": "En sustitución del artículo 53.",
        "C": "Solo para funcionarios.",
        "D": "Solo para empresas."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "La Administración debe asistir en medios electrónicos especialmente en:",
      "opciones": {
        "A": "Identificación y firma electrónica.",
        "B": "Cuestiones privadas.",
        "C": "Decisiones judiciales.",
        "D": "Actividades comerciales."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "La asistencia electrónica también puede incluir:",
      "opciones": {
        "A": "Presentación de solicitudes por registro electrónico general.",
        "B": "Modificación de leyes.",
        "C": "Resolución judicial.",
        "D": "Imposición de sanciones."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "La asistencia electrónica también incluye:",
      "opciones": {
        "A": "Obtención de copias auténticas.",
        "B": "Dictar sentencias.",
        "C": "Aprobar presupuestos.",
        "D": "Eliminar expedientes."
      },
      "respuesta_correcta": "A"
    },
    {
      "pregunta": "Un funcionario habilitado puede realizar la identificación o firma del interesado cuando:",
      "opciones": {
        "A": "Se cumplen los requisitos legales.",
